{
  "name": "codenames-masry",
  "productName": "Codenames Masry",
  "version": "1.0.0",
  "description": "كلمة سر — لعبة كود نيمز مصرية (Codenames Masry)",
  "main": "main.js",
  "author": "Codenames Masry",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/engine.test.mjs",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.masry.codenames",
    "productName": "Codenames Masry",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Codenames-Masry-${version}.exe"
    }
  }
}
